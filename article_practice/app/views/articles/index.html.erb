<h1>投稿一覧</h1>

<% if notice %><p class="text-green"><%= notice %></p><% end %>
<% if alert %><p class="text-red"><%= alert %></p><% end %>

<p><%= link_to "新規投稿", new_article_path %></p>

<table class="table-border">
  <tr>
    <th class="width-90">ID</th>
    <th class="width-300">タイトル</th>
  </tr>
  <% @articles.each do |article| %>
    <tr>
      <td><%= article.id %></td>
      <td><%= link_to article.title, article_path(article) %></td>
    </tr>
  <% end %>
</table>