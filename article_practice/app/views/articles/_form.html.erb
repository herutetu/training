<%= form_with model: article do |f| %>
  <div class="margin-bottom-10">
    <%= f.label :title, "タイトル" %><br>
    <%= f.text_field :title, class: "width-300" %>
  </div>
  <div class="margin-bottom-10">
    <%= f.label :content, "投稿内容" %><br>
    <%= f.text_area :content, rows: 6, class: "width-300" %>
  </div>
  <%= f.submit "送信" %>
<% end %>